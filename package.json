{
  "name": "claude-application",
  "version": "1.0.0",
  "description": "Full-stack application with React frontend and Express backend",
  "private": true,
  "main": "server/_core/index.js",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/_core/index.ts --bundle --platform=node --outdir=dist",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-kit": "^0.20.0",
    "drizzle-orm": "^0.28.0",
    "express": "^4.18.0",
    "jose": "^4.4.0",
    "mysql2": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.3.0",
    "trpc": "^0.5.0",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0"
  }
}
